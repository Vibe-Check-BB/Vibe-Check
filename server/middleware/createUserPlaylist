import SpotifyWebApi from 'spotify-web-api-node';
import dotenv from 'dotenv';
dotenv.config();

// credentials are optional
const spotifyApi = new SpotifyWebApi({
    clientId: process.env.SPOTIFY_CLIENT_ID,
    clientSecret: process.env.SPOTIFY_CLIENT_SECRET,
    redirectUri: process.env.SPOTIFY_REDIRECT_URI
});


function userAuthUrl() {
    const state = "ElevatorBabyBoyMusicFunTimes5!";
    const scopes = ['playlist-modify-public',]
    return spotifyApi.createAuthorizeURL(scopes, state)// generates URL to authenticate user and passes in the URI from spotifyApi
    // after user logs in:
    // redirects to URI, 
    // An authorization code that can be exchanged for an access token.
    // The value of the state parameter supplied in the request.
// grab auth code and exchange for Access token

// ** check if the returned state matches "ElevatorBabyBoyMusicFunTimes5!" sent.



// extract code parameter "code=AUTH_CODE" after URI redirect
    async function authenticateUser(authCode, returnedState, expectedState) {
        try {
            if (returnedState !== expectedState) {
                throw new Error("STATE MISMATCH <WE ARE UNDER ATTACK THIS IS NOT A DRILL *UNINSTALL WINDOWS FORCE*")
            }
        


            const data = await spotifyApi.authorizationCodeGrant(authCode); // send authCode to Spotify API
            // grab the access token (for making API requests) and store it in spotifyApi instance for use in future requests.
            // grab the refresh token (to get a new access token when it expires). and store it

            spotifyApi.setAccessToken(data.body.access_token);
            spotifyApi.setRefreshToken(data.body.refresh_token); // recommended to store in database(does not expire quickly)
        } catch (error) {
            console.log(`Error authenticating user, error:`, error);
        }
    }




    async function getUserId() {
        try {
        const userData = await spotifyApi.getMe(); // makes request to 'v1/me' and adds access token to Bearer in headers
        const userId = userData.body.id;
        return userId;            
        }catch(error) {
            console.error('Error fetching user ID:', error)
        }

    }

// ** spotifyApi.createPlaylist() works for the authenticated user without needing their ID.

